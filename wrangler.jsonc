{
	// Cloudflare deploy config: serves the static build in ./build as a single-page app.
	// Cloudflare build command: pnpm build   Deploy command: npx wrangler deploy
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buffalo",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	}
}
